async page => {
 const check=(value,message)=>{if(!value)throw new Error(message)};
 const errors=[];page.on('pageerror',e=>errors.push(e.message));
 const missing=[];page.on('response',r=>{if(r.status()>=400&&/characters|guide-|grammarch/.test(r.url()))missing.push(r.url())});
 const close=async()=>{await page.keyboard.press('Escape');await page.locator('.game-overlay').waitFor({state:'detached'})};
 await page.emulateMedia({reducedMotion:'reduce'});
 await page.setViewportSize({width:1440,height:900});await page.goto('http://127.0.0.1:3000');
 await page.evaluate(()=>{window.__spoken=[];window.speechSynthesis.speak=u=>{window.__spoken.push(u.text);u.onstart?.();u.onend?.()};window.speechSynthesis.cancel=()=>{}});
 await page.getByRole('button',{name:'Realms',exact:true}).click();
 const names=await page.locator('.realm-index__entry strong').allTextContents();
 check(names.length===18,'Missing realms');
 const portraits=new Set();const speakers=new Set();
 for(const name of names) {
  await page.locator('.realm-index__entry').filter({has:page.getByText(name,{exact:true})}).click();
  await page.locator('.atlas-crossing').waitFor({state:'detached'});
  const capital=name==='Centralia';
  const portrait=page.locator(capital?'.grammarch img':'.territory-guide img');
  await portrait.evaluate(img=>img.decode());
  check(await portrait.evaluate(img=>img.naturalWidth>0),'Portrait failed: '+name);
  const url=new URL(await portrait.getAttribute('src'),'http://127.0.0.1:3000');portraits.add(url.searchParams.get('url')||url.pathname);
  check(await page.locator('.territory-screen__mist,.scene-veil').count()===0,'Ambient clouds outside travel: '+name);
  if(!capital) {
   speakers.add(await page.locator('.guide-dialogue__speaker span').innerText());
   const before=await page.locator('.guide-dialogue p').innerText();
   await page.getByRole('button',{name:'Hear guardian',exact:true}).click();
   check(await page.evaluate(text=>window.__spoken.includes(text),before),'Voice did not receive guardian dialogue: '+name);
   await page.getByRole('button',{name:'Continue',exact:true}).click();
   await page.waitForFunction(text=>{const el=document.querySelector('.guide-dialogue p');return el&&el.textContent!==text&&Number(getComputedStyle(el.closest('.guide-dialogue')).opacity)>.99},before);
   await page.screenshot({path:`output/playwright/guardian-${name.replaceAll(' ','-')}.png`});
   await page.getByRole('button',{name:'Skip',exact:true}).click();
   await page.locator('.guide-dialogue').waitFor({state:'detached'});
   await page.getByRole('button',{name:['Artikel','Temporalia'].includes(name)?'Academy':'Topic Study Guide',exact:true}).click();
   await page.getByRole('heading',{name:'Core Grammar Rule',exact:true}).waitFor();
   check(await page.locator('.territory-rules > div').count()>0,'Study rules missing: '+name);
   check(await page.locator('.territory-example').count()>0,'Study examples missing: '+name);
  }
  check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'Desktop overflow: '+name);
  await close();
 }
 check(portraits.size===18,'Characters reuse portraits');check(speakers.size===17,'Characters reuse identities');
 await page.emulateMedia({reducedMotion:'no-preference'});
 await page.locator('.realm-index__entry').filter({has:page.getByText('Concordia',{exact:true})}).click();
 await page.locator('.atlas-crossing').waitFor({state:'detached'});
 await page.getByRole('button',{name:'Skip',exact:true}).click();
 await page.getByRole('button',{name:'LAUNCH ATTACK',exact:true}).click();
 await page.locator('.activity-transition--war[data-direction="enter"]').waitFor();
 check(await page.locator('.realm-return-clouds,.atlas-crossing__cloud,.scene-veil').count()===0,'Battle entry used clouds');
 await page.waitForTimeout(380);await page.screenshot({path:'output/playwright/new-war-entry.png'});
 await page.locator('.activity-transition').waitFor({state:'detached'});
 await page.getByRole('button',{name:'Retreat',exact:true}).click();
 await page.locator('.activity-transition--war[data-direction="exit"]').waitFor();
 check(await page.locator('.realm-return-clouds,.atlas-crossing__cloud').count()===0,'Battle exit used clouds');
 await page.waitForTimeout(200);await page.screenshot({path:'output/playwright/new-war-exit.png'});
 await page.locator('.game-overlay').waitFor({state:'detached'});
 await page.locator('.realm-index__entry').filter({has:page.getByText('Artikel',{exact:true})}).click();
 await page.locator('.atlas-crossing').waitFor({state:'detached'});
 await page.getByRole('button',{name:'Skip',exact:true}).click();
 await page.getByRole('button',{name:'Begin Training',exact:true}).click();
 await page.locator('.activity-transition--assessment[data-direction="enter"]').waitFor();
 check(await page.locator('.realm-return-clouds,.atlas-crossing__cloud,.war-gate').count()===0,'Assessment used clouds or war gates');
 await page.waitForTimeout(360);await page.screenshot({path:'output/playwright/new-assessment-entry.png'});
 await page.locator('.activity-transition').waitFor({state:'detached'});
 await page.keyboard.press('Escape');await page.locator('.activity-transition--assessment[data-direction="exit"]').waitFor();
 await page.locator('.game-overlay').waitFor({state:'detached'});
 await page.getByRole('button',{name:'Open commander profile for Arjun Verma',exact:true}).click();
 check(await page.locator('.scene-veil,.atlas-crossing__cloud,.realm-return-clouds').count()===0,'Profile used clouds');await close();
 await page.getByRole('button',{name:'Assaults',exact:true}).click();await page.locator('.activity-transition--war').waitFor();
 check(await page.locator('.atlas-crossing__cloud,.realm-return-clouds').count()===0,'War council used clouds');await close();
 await page.setViewportSize({width:390,height:844});
 await page.locator('.realm-index__entry').filter({has:page.getByText('Mayhaven',{exact:true})}).click();
 await page.locator('.atlas-crossing').waitFor({state:'detached'});
 await page.screenshot({path:'output/playwright/guardian-phone-intro.png'});
 await page.getByRole('button',{name:'Skip',exact:true}).click();
 await page.getByRole('button',{name:'Topic Study Guide',exact:true}).click();
 await page.getByRole('heading',{name:'Core Grammar Rule'}).waitFor();
 await page.screenshot({path:'output/playwright/guardian-phone-academy.png'});
 check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth),'Phone overflow');
 const launch=page.getByRole('button',{name:'LAUNCH ATTACK',exact:true});
 await launch.scrollIntoViewIfNeeded();
 const bounds=await launch.boundingBox();check(bounds.y>=0&&bounds.y+bounds.height<=844,'Phone training control is clipped');
 await launch.click();await page.locator('.activity-transition--war').waitFor();await close();
 if(errors.length||missing.length)throw new Error([...errors,...missing].join('\n'));
 console.log('PASS: all 18 unique portraits, 17 identities and voice/dialogue/study flows, distinct war/assessment entry and exit, no clouds outside state travel, phone layout.');
}
